# Server
HOST=0.0.0.0
PORT=8000

# Local LLM
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3:8b

# Cloud LLM
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=deepseek-v4-pro

# Generation tuning
TOKEN_BUDGET=4000
OUTPUT_RESERVE=1500
MAX_FIX_ITERATIONS=2
TEMPERATURE=0.4

# Qwen3 no_think injection (prepended to the system prompt when thinking is disabled
# and the local model is Qwen3, detected from LOCAL_LLM_MODEL). Set NO_THINK_ENABLED=false
# to disable.
NO_THINK_ENABLED=true
NO_THINK_DIRECTIVE=/no_think

# When the plan fails, return the page shell with unfilled placeholders
# (skip researcher + composer — saves ~8 LLM calls). Set to false to run
# the full fallback pipeline with a fallback plan.
SHELL_ON_PLAN_FAIL=true

# How to handle plan-generation failure: "error" (raise, surface the failure)
# or "fallback" (silently return a fallback plan and continue the pipeline).
PLAN_FAIL_MODE=error
